{
  "name": "steprealm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StepRealm REST API — Node.js / Express / PostgreSQL",
  "scripts": {
    "dev": "tsx watch src/index.ts",
