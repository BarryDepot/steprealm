# Connection to the hosted (Render) database.
#
# Copy this file to .env.render and fill in the real connection string. Like
# .env, the filled-in copy is gitignored — this template is committed so that
# anyone cloning the repo can see what is required.
#
# Only `npm run db:setup:remote` reads this file. Ordinary development, the
# tests and `npm start` all read .env and are unaffected by it, so there is
# never a reason to edit DATABASE_URL by hand to switch environments.
#
# Use Render's **External** Database URL, not the Internal one. The Internal
# URL resolves only from inside Render's own network; from your laptop it will
# fail to connect.
#
#   Render dashboard → your Postgres instance → Connections → External Database URL
#
DATABASE_URL=postgresql://USER:PASSWORD@HOST.frankfurt-postgres.render.com/DATABASE

# Hosted Postgres requires TLS. Leave this as true.
PGSSL=true
